{
  "name": "@castalia/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run tests",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src",
    "contract:lint": "redocly lint openapi/castalia-bff.openapi.yaml",
    "contract:bundle": "redocly bundle openapi/castalia-bff.openapi.yaml --output dist/castalia-bff.openapi.yaml",
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/check-generated.mjs"
  },
  "devDependencies": {
    "@redocly/cli": "2.39.0",
    "@types/node": "24.10.13",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "json-schema-to-typescript": "15.0.4",
    "openapi-typescript": "7.13.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "vitest": "4.1.0",
    "yaml": "2.8.3"
  }
}
